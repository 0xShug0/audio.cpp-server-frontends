diff --git a/external/ggml/src/ggml-hip/gfx1151_v1/mmvq.cu b/external/ggml/src/ggml-hip/gfx1151_v1/mmvq.cu
new file mode 100644
index 00000000..68b5447b
--- /dev/null
+++ b/external/ggml/src/ggml-hip/gfx1151_v1/mmvq.cu
@@ -0,0 +1,82 @@
+#include "gfx1151_v1.cuh"
+#include "ggml-cuda/mmvq.cuh"
+#include "ggml-cuda/vecdotq.cuh"
+#include <climits>
+#include <type_traits>
+
+namespace {
+using q8_pair = int __attribute__((vector_size(8), aligned(2), may_alias));
+
+template<int cols>
+#ifdef __HIP_DEVICE_COMPILE__
+__attribute__((target("unaligned-access-mode")))
+#endif
+__global__ __launch_bounds__(128) void gfx1151_v1_mmvq(
+        const block_q8_0 * a, const block_q8_1 * b, float * dst,
+        int m, int k, int stride_a, int stride_b) {
+    const int lane = threadIdx.x;
+    const int64_t row = int64_t(blockIdx.x) * 4 + threadIdx.y;
+    const int quant = 2 * (lane % 4);
+    if (row >= m) return;
+    float sum[cols] = {};
+#pragma clang loop unroll_count(2)
+    for (int index = 0; index < k / (QK8_0 * 8); ++index) {
+        const int block = index * 8 + lane / 4;
+        int u[cols][2];
+        float scale_b[cols];
+#pragma unroll
+        for (int c = 0; c < cols; ++c) {
+            const auto & x = b[c * stride_b + block];
+            u[c][0] = get_int_b4(x.qs, quant);
+            u[c][1] = get_int_b4(x.qs, quant + 1);
+            scale_b[c] = __half2float(__low2half(x.ds));
+        }
+        const auto & w = a[row * stride_a + block];
+        const q8_pair value = __builtin_nontemporal_load(
+            reinterpret_cast<const q8_pair *>(w.qs + quant * 4));
+        const int v[2] = {value[0], value[1]};
+#pragma unroll
+        for (int c = 0; c < cols; ++c) {
+            sum[c] += vec_dot_q8_0_q8_1_impl<float, 2>(v, u[c], __half2float(w.d), scale_b[c]);
+        }
+    }
+#pragma unroll
+    for (int c = 0; c < cols; ++c) {
+        const float value = warp_reduce_sum<32>(sum[c]);
+        if (lane == 0) dst[int64_t(c) * m + row] = value;
+    }
+}
+} // namespace
+
+bool ggml_hip_gfx1151_v1_mmvq(const ggml_tensor * a, const ggml_tensor * b, const ggml_tensor * ids,
+                            const void * q8, const ggml_cuda_mm_fusion_args_device & fusion,
+                            ggml_tensor * dst, hipStream_t stream) {
+    if (a->type != GGML_TYPE_Q8_0 || b->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32 ||
+        dst->op != GGML_OP_MUL_MAT || ids || a->ne[2] != 1 || a->ne[3] != 1 ||
+        b->ne[2] != 1 || b->ne[3] != 1 || b->ne[1] < 1 || b->ne[1] > 8 ||
+        !ggml_is_contiguous(dst) || fusion.gate || fusion.x_bias || fusion.gate_bias || fusion.residual_only ||
+        a->ne[0] < 256 || a->ne[0] > INT_MAX || a->ne[0] % 256 || a->ne[1] < 1 || a->ne[1] > INT_MAX ||
+        a->nb[0] != sizeof(block_q8_0) || a->nb[1] % sizeof(block_q8_0) ||
+        a->nb[1] / sizeof(block_q8_0) > INT_MAX) {
+        return false;
+    }
+    const dim3 grid((a->ne[1] + 3) / 4);
+    const auto launch = [&](auto cols_tag) {
+        constexpr int cols = decltype(cols_tag)::value;
+        gfx1151_v1_mmvq<cols><<<grid, dim3(32, 4), 0, stream>>>(
+            static_cast<const block_q8_0 *>(a->data), static_cast<const block_q8_1 *>(q8),
+            static_cast<float *>(dst->data), a->ne[1], a->ne[0],
+            a->nb[1] / sizeof(block_q8_0), GGML_PAD(b->ne[0], MATRIX_ROW_PADDING) / QK8_1);
+    };
+    switch (b->ne[1]) {
+        case 1: launch(std::integral_constant<int, 1>{}); break;
+        case 2: launch(std::integral_constant<int, 2>{}); break;
+        case 3: launch(std::integral_constant<int, 3>{}); break;
+        case 4: launch(std::integral_constant<int, 4>{}); break;
+        case 5: launch(std::integral_constant<int, 5>{}); break;
+        case 6: launch(std::integral_constant<int, 6>{}); break;
+        case 7: launch(std::integral_constant<int, 7>{}); break;
+        case 8: launch(std::integral_constant<int, 8>{}); break;
+    }
+    return true;
+}
