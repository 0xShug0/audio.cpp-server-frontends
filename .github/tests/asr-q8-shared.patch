new file mode 100644
index 00000000..fc91a45a
--- /dev/null
+++ b/external/ggml/src/ggml-hip/gfx1151_v1/mmvq.cu
@@ -0,0 +1,98 @@
+#include "gfx1151_v1.cuh"
+#include "ggml-cuda/mmvq.cuh"
+#include "ggml-cuda/vecdotq.cuh"
+#include "ggml-cuda/unary.cuh"
+#include <type_traits>
+
+namespace {
+using q8_pair = int __attribute__((vector_size(8), aligned(2), may_alias));
+
+template<int cols, bool gated>
+#ifdef __HIP_DEVICE_COMPILE__
+__attribute__((target("unaligned-access-mode")))
+#endif
+__global__ __launch_bounds__(128) void gfx1151_v1_q8_stream(
+        const char * weights, const char * gate_weights, const block_q8_1 * input, float * output,
+        int rows, int blocks, size_t row_stride, size_t channel_stride, size_t sample_stride,
+        int channels_per_weight, int samples_per_weight, int input_stride,
+        size_t output_col_stride, size_t output_channel_stride, size_t output_sample_stride) {
+    const int lane = threadIdx.x;
+    const int row = blockIdx.x * 4 + threadIdx.y;
+    if (row >= rows) return;
+    const size_t weight_offset = row * row_stride +
+        (blockIdx.y / channels_per_weight) * channel_stride +
+        (blockIdx.z / samples_per_weight) * sample_stride;
+    const auto * w = reinterpret_cast<const block_q8_0 *>(weights + weight_offset);
+    const block_q8_0 * g = nullptr;
+    if constexpr (gated) g = reinterpret_cast<const block_q8_0 *>(gate_weights + weight_offset);
+    input += (size_t(blockIdx.z) * gridDim.y + blockIdx.y) * cols * input_stride;
+    output += blockIdx.z * output_sample_stride + blockIdx.y * output_channel_stride + row;
+    constexpr int lanes_per_block = QI8_0 / VDR_Q8_0_Q8_1_MMVQ;
+    constexpr int blocks_per_wave = 32 / lanes_per_block;
+    const int quant = VDR_Q8_0_Q8_1_MMVQ * (lane % lanes_per_block);
+    float sum[cols] = {};
+    float gate_sum[gated ? cols : 1] = {};
+    const auto accumulate = [&](int block) {
+        const auto value = __builtin_nontemporal_load(reinterpret_cast<const q8_pair *>(w[block].qs + quant * 4));
+        const int v[2] = {value[0], value[1]};
+        int vg[2];
+        if constexpr (gated) {
+            const auto gv = __builtin_nontemporal_load(reinterpret_cast<const q8_pair *>(g[block].qs + quant * 4));
+            vg[0] = gv[0]; vg[1] = gv[1];
+        }
+#pragma unroll
+        for (int c = 0; c < cols; ++c) {
+            const auto & x = input[c * input_stride + block];
+            const int u[2] = {get_int_b4(x.qs, quant), get_int_b4(x.qs, quant + 1)};
+            sum[c] += vec_dot_q8_0_q8_1_impl<float, 2>(v, u, w[block].d, __low2half(x.ds));
+            if constexpr (gated) {
+                gate_sum[c] += vec_dot_q8_0_q8_1_impl<float, 2>(vg, u, g[block].d, __low2half(x.ds));
+            }
+        }
+    };
+    // Full groups have a wave-uniform bound; only the final group needs a lane mask.
+    const int groups = blocks / blocks_per_wave;
+#pragma clang loop unroll(disable)
+    for (int group = 0; group < groups; ++group) accumulate(group * blocks_per_wave + lane / lanes_per_block);
+    const int tail = groups * blocks_per_wave + lane / lanes_per_block;
+    if (tail < blocks) accumulate(tail);
+#pragma unroll
+    for (int c = 0; c < cols; ++c) {
+        float result = warp_reduce_sum<32>(sum[c]);
+        if constexpr (gated) result *= ggml_cuda_op_silu_single(warp_reduce_sum<32>(gate_sum[c]));
+        if (lane == 0) output[c * output_col_stride] = result;
+    }
+}
