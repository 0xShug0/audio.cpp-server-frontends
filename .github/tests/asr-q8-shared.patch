+struct test_mul_mat_exact_swiglu : public test_case {
+    const int64_t m, n, k;
+    const bool metadata, extra_consumer, separate_input, offset;
+
+    test_mul_mat_exact_swiglu(int64_t m, int64_t n, int64_t k, bool metadata = true,
+                             bool extra_consumer = false, bool separate_input = false, bool offset = false)
+        : m(m), n(n), k(k), metadata(metadata), extra_consumer(extra_consumer), separate_input(separate_input), offset(offset) {}
+
+    std::string op_desc(ggml_tensor *) override { return "MUL_MAT_EXACT_SWIGLU"; }
+    std::string vars() override { return VARS_TO_STR7(m, n, k, metadata, extra_consumer, separate_input, offset); }
+    bool run_whole_graph() override { return true; }
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        auto * input = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, k, 1, n);
+        if (offset) {
+            input = ggml_view_3d(ctx, ggml_new_tensor_1d(ctx, GGML_TYPE_F32, k * n + 32),
+                                 k, 1, n, k * sizeof(float), k * sizeof(float), 32 * sizeof(float));
+        }
+        auto * gate_input = metadata ? ggml_reshape_2d(ctx, input, k, n) : input;
+        auto * gate = ggml_mul_mat(ctx, ggml_new_tensor_2d(ctx, GGML_TYPE_Q8_0, k, m), gate_input);
+        if (metadata) gate = ggml_reshape_3d(ctx, gate, m, 1, n);
+        auto * silu = ggml_silu(ctx, gate);
+        auto * up_input = separate_input ? ggml_new_tensor_3d(ctx, GGML_TYPE_F32, k, 1, n) : input;
+        if (metadata) up_input = ggml_reshape_2d(ctx, up_input, k, n);
+        auto * up = ggml_mul_mat(ctx, ggml_new_tensor_2d(ctx, GGML_TYPE_Q8_0, k, m), up_input);
+        if (metadata) up = ggml_reshape_3d(ctx, up, m, 1, n);
+        auto * out = ggml_mul(ctx, silu, up);
+        return extra_consumer ? ggml_add(ctx, out, gate) : out;
+    }
+};
