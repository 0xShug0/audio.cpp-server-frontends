diff --git a/external/ggml/src/ggml-cuda/mmvq.cuh b/external/ggml/src/ggml-cuda/mmvq.cuh
index e6071e41..748311ad 100644
--- a/external/ggml/src/ggml-cuda/mmvq.cuh
+++ b/external/ggml/src/ggml-cuda/mmvq.cuh
@@ -2,6 +2,54 @@
 
 #define MMVQ_MAX_BATCH_SIZE 8 // Max. batch size for which to use MMVQ kernels.
 
+#ifdef GGML_USE_HIP
+// Prepared activations are valid only within one serial graph evaluation.
+struct ggml_hip_q8_cache {
+    ggml_backend_cuda_context & ctx;
+    ggml_tensor source = {};
+    const ggml_tensor * input = nullptr;
+    char * data = nullptr;
+    size_t size = 0;
+
+    explicit ggml_hip_q8_cache(ggml_backend_cuda_context & ctx) : ctx(ctx) {
+        GGML_ASSERT(ctx.q8_cache == nullptr);
+        ctx.q8_cache = this;
+    }
+
+    ggml_hip_q8_cache(const ggml_hip_q8_cache &) = delete;
+    ggml_hip_q8_cache & operator=(const ggml_hip_q8_cache &) = delete;
+
+    ~ggml_hip_q8_cache() {
+        ctx.q8_cache = nullptr;
+        if (data) ctx.pool().free(data, size);
+    }
+
+    bool matches(const ggml_tensor * input) const {
+        return source.data == input->data && source.type == input->type &&
+               ggml_are_same_shape(&source, input) && ggml_are_same_stride(&source, input);
+    }
+
+    void allocate(size_t bytes) {
+        if (bytes > size) {
+            if (data) ctx.pool().free(data, size);
+            data = static_cast<char *>(ctx.pool().alloc(bytes, &size));
+        }
+    }
+
+    void invalidate(const ggml_tensor * output) {
+        if (!source.data || output->op == GGML_OP_NONE || output->op == GGML_OP_VIEW ||
+            output->op == GGML_OP_RESHAPE || output->op == GGML_OP_TRANSPOSE || output->op == GGML_OP_PERMUTE) {
+            return;
+        }
+        const auto src = reinterpret_cast<uintptr_t>(source.data);
+        const auto dst = reinterpret_cast<uintptr_t>(output->data);
+        if (dst < src ? src - dst < ggml_nbytes(output) : dst - src < ggml_nbytes(&source)) {
+            source.data = nullptr;
+        }
+    }
+};
+#endif
+
 // Returns the maximum batch size for which MMVQ should be used for MUL_MAT_ID,
 // based on the quantization type and GPU architecture (compute capability).
 int get_mmvq_mmid_max_batch(ggml_type type, int cc);
