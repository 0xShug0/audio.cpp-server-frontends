+                            const ggml_cuda_mm_fusion_args_device & fusion, ggml_tensor * dst, hipStream_t stream) {
+    if (a->type != GGML_TYPE_Q8_0 || b->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32 ||
+        b->ne[1] < 1 || b->ne[1] > MMVQ_MAX_BATCH_SIZE ||
