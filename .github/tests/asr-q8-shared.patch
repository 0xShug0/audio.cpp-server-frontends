+struct test_mul_mat_shared_input : public test_case {
+    const int64_t m, n, k;
+    const bool mutate, strided;
+
+    test_mul_mat_shared_input(int64_t m, int64_t n, int64_t k, bool mutate = false, bool strided = false)
+        : m(m), n(n), k(k), mutate(mutate), strided(strided) {}
+
+    std::string op_desc(ggml_tensor *) override { return "MUL_MAT_SHARED"; }
+    std::string vars() override { return VARS_TO_STR5(m, n, k, mutate, strided); }
+    bool run_whole_graph() override { return true; }
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        auto * input = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, k + (strided ? 32 : 0), n);
+        auto * first = strided ? ggml_view_2d(ctx, input, k, n, input->nb[1], 0) : input;
+        auto * a = ggml_new_tensor_2d(ctx, GGML_TYPE_Q8_0, k, m);
+        auto * out = ggml_mul_mat(ctx, a, first);
+        auto * next = mutate ? ggml_scale_inplace(ctx, input, 0.5f) : input;
+        // Separate tensor headers exercise equivalent module-created views.
+        next = ggml_view_2d(ctx, next, k, n, next->nb[1], 0);
+        auto * b = ggml_new_tensor_2d(ctx, GGML_TYPE_Q8_0, k, m + 1);
+        auto * second = ggml_mul_mat(ctx, b, next);
+        out = ggml_concat(ctx, out, second, 0);
+        auto * c = ggml_new_tensor_2d(ctx, GGML_TYPE_Q8_0, k, m + 3);
+        auto * third = ggml_mul_mat(ctx, c, next);
+        return ggml_concat(ctx, out, third, 0);
+    }
+};
