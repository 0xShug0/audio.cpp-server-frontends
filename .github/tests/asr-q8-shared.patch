+        const auto run = [&](auto use_gate) {
+            gfx1151_v1_q8_stream<cols, decltype(use_gate)::value><<<grid, dim3(32, 4), 0, stream>>>(
+                static_cast<const char *>(a->data), static_cast<const char *>(fusion.gate),
+                static_cast<const block_q8_1 *>(q8), static_cast<float *>(dst->data),
