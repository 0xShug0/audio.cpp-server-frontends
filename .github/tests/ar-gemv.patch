+        a->nb[0] != sizeof(block_q8_0) || a->nb[1] % alignof(block_q8_0) != 0 ||
+        !ggml_is_contiguous(b) || !ggml_is_contiguous(out) ||
+        reinterpret_cast<uintptr_t>(b->data) % alignof(float4) != 0) {
+        return false;
+    }
+    // Larger projections retain the faster quantized HIP matvec.
+    if (a->ne[0] > 2048 || a->ne[1] > 2048 || a->ne[0] * a->ne[1] > 2048 * 1024 ||
+        (b->ne[1] == 2 && (a->ne[0] > 1024 || a->ne[1] > 1024))) {
+        return false;
+    }
+    const dim3 grid((a->ne[1] + 3) / 4);
+    if (b->ne[1] == 1) {
