+            static_cast<const char *>(a->data), static_cast<const float *>(b->data),
+            static_cast<float *>(out->data), int(a->ne[1]), int(a->ne[0]), a->nb[1]);
+    } else {
+        gfx1151_v1_gemv_q8<2><<<grid, dim3(32, 4), 0, stream>>>(
+            static_cast<const char *>(a->data), static_cast<const float *>(b->data),
+            static_cast<float *>(out->data), int(a->ne[1]), int(a->ne[0]), a->nb[1]);
+    }
+    return true;
+}
