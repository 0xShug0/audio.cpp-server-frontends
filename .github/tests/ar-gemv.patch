 namespace {
 
+template<int cols>
+__global__ __launch_bounds__(128) void gfx1151_v1_gemv_q8(
+        const char * a, const float * b, float * out, int m, int k, size_t stride) {
+    const int lane = threadIdx.x;
+    const int row = blockIdx.x * 4 + threadIdx.y;
+    if (row >= m) {
+        return;
+    }
+    const auto * weights = reinterpret_cast<const block_q8_0 *>(a + row * stride);
+    float sums[cols] = {};
+    for (int block = lane / 8; block < k / QK8_0; block += 4) {
+        const int q = (lane % 8) * 4;
+        const auto & w = weights[block];
+#pragma unroll
+        for (int c = 0; c < cols; ++c) {
+            const float4 x = reinterpret_cast<const float4 *>(b + c * k + block * QK8_0)[q / 4];
+            float v = float(w.qs[q]) * x.x;
+            v = fmaf(float(w.qs[q + 1]), x.y, v);
+            v = fmaf(float(w.qs[q + 2]), x.z, v);
+            v = fmaf(float(w.qs[q + 3]), x.w, v);
+            sums[c] = fmaf(__half2float(w.d), v, sums[c]);
+        }
+    }
+#pragma unroll
+    for (int c = 0; c < cols; ++c) {
+        const float v = warp_reduce_sum<32>(sums[c]);
+        if (lane == 0) {
+            out[c * m + row] = v;
+        }
+    }
+}
