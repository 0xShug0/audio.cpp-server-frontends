+void test_hip_implementation_selection(bool require_rocm_v2) {
+    BackendConfig config;
+    config.type = BackendType::Hip;
+    config.implementation = "unknown";
+    require(
+        init_backend_error(config).find("Unsupported HIP implementation: unknown") != std::string::npos,
+        "unknown HIP implementation must be rejected explicitly");
+
+    config.implementation = "rocm_v2";
+    BackendConfig cpu_copy = config;
+    cpu_copy.type = BackendType::Cpu;
+    BackendHandle cpu(engine::core::init_backend(cpu_copy));
+    require(engine::core::is_host_backend(cpu.handle), "HIP tuning must not affect an intentional CPU copy");
+
+    ensure_backends_loaded();
+    for (size_t i = 0; i < ggml_backend_reg_count(); ++i) {
+        ggml_backend_reg_t reg = ggml_backend_reg_get(i);
+        if (std::strcmp(ggml_backend_reg_name(reg), "ROCm") != 0) {
+            continue;
+        }
+        if (ggml_backend_reg_dev_count(reg) == 0) {
+            continue;
+        }
+        if (ggml_backend_reg_get_proc_address(reg, "ggml_backend_rocm_v2_init") == nullptr) {
+            require(!require_rocm_v2, "this run requires rocm_v2 initialization support");
+            require(
+                init_backend_error(config).find("not supported by this backend build") != std::string::npos,
+                "older HIP builds must reject rocm_v2 before device initialization");
+            return;
+        }
+
+        if (require_rocm_v2) {
+            BackendHandle variant(engine::core::init_backend(config));
+            require(engine::core::backend_type(variant.handle) == BackendType::Hip,
+                    "rocm_v2 must retain logical HIP identity");
+            require(!engine::core::uses_host_graph_plan(variant.handle), "rocm_v2 must remain a GPU backend");
+        }
+        config.implementation.clear();
+        BackendHandle standard(engine::core::init_backend(config));
+        require(engine::core::backend_type(standard.handle) == BackendType::Hip,
+                "default HIP must remain available when rocm_v2 is supported");
+        return;
+    }
+    require(!require_rocm_v2, "this run requires a HIP device with rocm_v2 support");
+    require(!init_backend_error(config).empty(), "rocm_v2 must fail when no HIP device is available");
+}
+
 }  // namespace
 
