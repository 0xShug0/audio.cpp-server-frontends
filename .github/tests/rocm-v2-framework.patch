diff --git a/tests/unittests/test_backend_config_args.cpp b/tests/unittests/test_backend_config_args.cpp
new file mode 100644
index 00000000..eb29ac95
--- /dev/null
+++ b/tests/unittests/test_backend_config_args.cpp
@@ -0,0 +1,62 @@
+#include "../../app/cli/args.h"
+#include "test_assert.h"
+
+#include <chrono>
+#include <iostream>
+#include <string>
+#include <utility>
+
+int main(int argc, char ** argv) {
+    const auto start = std::chrono::steady_clock::now();
+    try {
+        using engine::core::BackendType;
+        using engine::test::require;
+        using engine::test::require_eq;
+
+        for (const auto & [spelling, type] : {
+                 std::pair{"cpu", BackendType::Cpu},
+                 std::pair{"cuda", BackendType::Cuda},
+                 std::pair{"hip", BackendType::Hip},
+                 std::pair{"rocm", BackendType::Hip},
+                 std::pair{"rocm_v2", BackendType::Hip},
+                 std::pair{"vulkan", BackendType::Vulkan},
+                 std::pair{"metal", BackendType::Metal},
+                 std::pair{"best", BackendType::BestAvailable},
+             }) {
+            const auto config = minitts::cli::parse_backend_config(spelling);
+            require(config.type == type, std::string(spelling) + " logical backend");
+            require(minitts::cli::parse_backend(spelling) == type, std::string(spelling) + " enum compatibility");
+            require_eq(config.implementation, std::string(spelling == std::string("rocm_v2") ? "rocm_v2" : ""),
+                       std::string(spelling) + " implementation");
+            require_eq(config.device, 0, "default device");
+            require_eq(config.threads, 1, "default threads");
+        }
+
+        for (const char * spelling : {"", "rocm_v3", "cuda:rocm_v2", "HIP", "rocm_v2 "}) {
+            bool rejected = false;
+            try {
+                (void)minitts::cli::parse_backend_config(spelling);
+            } catch (const std::runtime_error & error) {
+                require_eq(std::string(error.what()), "unsupported backend: " + std::string(spelling),
+                           "invalid backend error");
+                rejected = true;
+            }
+            require(rejected, std::string("invalid backend accepted: ") + spelling);
+        }
+
+        const auto variant = minitts::cli::parse_backend_config("rocm_v2");
+        const auto standard = minitts::cli::parse_backend_config("hip");
+        require_eq(variant.implementation, std::string("rocm_v2"), "variant remains selected independently");
+        require(standard.implementation.empty(), "explicit hip selects the default implementation");
+    } catch (const std::exception & error) {
+        std::cerr << "backend_config_args_test failed: " << error.what() << '\n';
+        return 1;
+    }
+    if (minitts::cli::has_arg(argc, argv, "--log")) {
+        std::cout << "session.wall_ms="
+                  << std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - start).count()
+                  << '\n';
+    }
+    std::cout << "backend_config_args_test passed\n";
+    return 0;
+}
