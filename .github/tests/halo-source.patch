+
+const char * const * ggml_backend_dev_get_implementations(ggml_backend_dev_t device) {
+    GGML_ASSERT(device);
+    auto fn = (ggml_backend_dev_get_implementations_t) ggml_backend_reg_get_proc_address(
+        device->reg, "ggml_backend_dev_get_implementations");
+    static const char * const defaults[] = { "default", nullptr };
+    return fn ? fn(device) : defaults;
+}
+
+ggml_backend_t ggml_backend_dev_init_with_implementation(
+        ggml_backend_dev_t device, const char * implementation, const char * params) {
+    GGML_ASSERT(device);
+    if (!implementation || !implementation[0] || strcmp(implementation, "default") == 0) {
+        return ggml_backend_dev_init(device, params);
+    }
+    auto fn = (ggml_backend_dev_init_with_implementation_t) ggml_backend_reg_get_proc_address(
+        device->reg, "ggml_backend_dev_init_with_implementation");
+    if (!fn) {
+        GGML_LOG_ERROR("%s: implementation '%s' is not supported\n", ggml_backend_dev_name(device), implementation);
+        return nullptr;
+    }
+    return fn(device, implementation, params);
+}
