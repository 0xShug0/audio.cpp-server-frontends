+void test_backend_implementations() {
+    for (size_t i = 0; i < ggml_backend_dev_count(); ++i) {
+        auto dev = ggml_backend_dev_get(i);
+        const char * const * names = ggml_backend_dev_get_implementations(dev);
+        require(names && names[0] && std::string(names[0]) == "default", "default implementation is discoverable");
+        BackendHandle original(ggml_backend_dev_init(dev, nullptr));
+        require(original.handle != nullptr, "original initialization");
+        require_eq(std::string(ggml_backend_get_implementation(original.handle)), std::string("default"), "default identity");
+        require(ggml_backend_dev_init_with_implementation(dev, "invalid-implementation", nullptr) == nullptr,
+                "unknown implementation must not be ignored");
+        for (size_t j = 0; names[j]; ++j) {
+            BackendHandle selected(ggml_backend_dev_init_with_implementation(dev, names[j], nullptr));
+            require(selected.handle != nullptr, "advertised implementation initializes");
+            require_eq(std::string(ggml_backend_get_implementation(selected.handle)), std::string(names[j]), "selected identity");
+            require_eq(std::string(ggml_backend_get_implementation(original.handle)), std::string("default"), "instance isolation");
+        }
+        BackendHandle empty(ggml_backend_dev_init_with_implementation(dev, "", nullptr));
+        require(empty.handle != nullptr, "empty implementation initializes the default");
+        require_eq(std::string(ggml_backend_get_implementation(empty.handle)), std::string("default"), "empty identity");
+    }
+}
