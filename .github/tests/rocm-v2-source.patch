diff --git a/external/ggml/src/ggml-hip/rocm_v2/sgemm.cu b/external/ggml/src/ggml-hip/rocm_v2/sgemm.cu
new file mode 100644
index 00000000..d94f0be4
--- /dev/null
+++ b/external/ggml/src/ggml-hip/rocm_v2/sgemm.cu
@@ -0,0 +1,88 @@
+#include "rocm_v2.cuh"
+#include <climits>
+
+namespace {
+
+// Reuse each 64x32 operand tile for 64 output rows/columns. Unlike reduced-
+// precision matrix instructions, this retains FP32 inputs and accumulation.
+__global__ __launch_bounds__(256) void rocm_v2_sgemm(
+    const float * __restrict__ a, const float * __restrict__ b, float * __restrict__ c,
+    int64_t m, int64_t n, int64_t k, int64_t lda, int64_t ldb, int64_t ldc,
+    int64_t sa, int64_t sb, int64_t sc) {
+    __shared__ float aa[32][65];
+    __shared__ float bb[32][65];
+    const int tid = threadIdx.x;
+    const int row = tid % 16;
+    const int col = tid / 16;
+    const int64_t row0 = int64_t(blockIdx.x) * 64;
+    const int64_t col0 = int64_t(blockIdx.y) * 64;
+    a += int64_t(blockIdx.z) * sa;
+    b += int64_t(blockIdx.z) * sb;
+    c += int64_t(blockIdx.z) * sc;
+    float sum[4][4] = {};
+    for (int64_t base = 0; base < k; base += 32) {
+#pragma unroll
+        for (int i = 0; i < 8; ++i) {
+            const int index = tid + i * 256;
+            const int kk = index % 32;
+            const int rr = index / 32;
+            aa[kk][rr] = base + kk < k && row0 + rr < m ? a[(row0 + rr) * lda + base + kk] : 0;
+            bb[kk][rr] = base + kk < k && col0 + rr < n ? b[(col0 + rr) * ldb + base + kk] : 0;
+        }
+        __syncthreads();
+#pragma unroll
+        for (int kk = 0; kk < 32; ++kk) {
+            float av[4], bv[4];
+#pragma unroll
+            for (int i = 0; i < 4; ++i) {
+                av[i] = aa[kk][row + i * 16];
+                bv[i] = bb[kk][col + i * 16];
+            }
+#pragma unroll
+            for (int i = 0; i < 4; ++i) {
+#pragma unroll
+                for (int j = 0; j < 4; ++j) {
+                    sum[i][j] = fmaf(av[i], bv[j], sum[i][j]);
+                }
+            }
+        }
+        __syncthreads();
+    }
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+#pragma unroll
+        for (int j = 0; j < 4; ++j) {
+            if (row0 + row + i * 16 < m && col0 + col + j * 16 < n) {
+                c[(col0 + col + j * 16) * ldc + row0 + row + i * 16] = sum[i][j];
+            }
+        }
+    }
+}
+
+} // namespace
+
+bool ggml_rocm_v2_mul_mat(const ggml_tensor * a, const ggml_tensor * b,
+                          ggml_tensor * out, hipStream_t stream) {
+    if (a->type != GGML_TYPE_F32 || b->type != GGML_TYPE_F32 || out->type != GGML_TYPE_F32 ||
+        a->ne[2] != 1 || a->ne[3] != 1 || b->ne[2] != 1 || b->ne[3] != 1 ||
+        a->nb[0] != sizeof(float) || b->nb[0] != sizeof(float) || !ggml_is_contiguous(out)) {
+        return false;
+    }
+    const int64_t m = a->ne[1], n = b->ne[1], k = a->ne[0];
+    // Small and narrow matrices retain HIP's vector/library kernels.
+    if (m < 64 || n < 768 || k < 256 || m > INT_MAX || n > 65535 * 64 || k > INT_MAX ||
+        a->nb[1] < size_t(k) * sizeof(float) || b->nb[1] < size_t(k) * sizeof(float) ||
+        a->nb[1] % sizeof(float) || b->nb[1] % sizeof(float)) {
+        return false;
+    }
+    // Require enough work and independent tiles to amortize LDS setup on gfx1151.
+    if (m * n < ((int64_t{512} << 20) + k - 1) / k ||
+        ((m + 63) / 64) * ((n + 63) / 64) < 64) {
+        return false;
+    }
+    rocm_v2_sgemm<<<dim3((m + 63) / 64, (n + 63) / 64), 256, 0, stream>>>(
+        static_cast<const float *>(a->data), static_cast<const float *>(b->data),
+        static_cast<float *>(out->data), m, n, k, a->nb[1] / sizeof(float),
+        b->nb[1] / sizeof(float), m, 0, 0, 0);
+    return true;
+}
