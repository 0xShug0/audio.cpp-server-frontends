+bool ggml_hip_gfx1151_v1_mmvq(const ggml_tensor * a, const void * b, int64_t b_stride,
+                             ggml_tensor * out, hipStream_t stream, int cc) {
+    if (cc != GGML_CUDA_CC_OFFSET_AMD + 0x1151 || a->type != GGML_TYPE_Q4_0 ||
+        out->op != GGML_OP_MUL_MAT || ggml_get_op_params_i32(out, 1) != GGML_MUL_MAT_LOWERING_DEFAULT ||
+        out->ne[1] != 2 || !ggml_is_matrix(a) || !ggml_is_matrix(out) ||
+        !ggml_is_contiguous(a) || !ggml_is_contiguous(out) ||
+        a->ne[0] < 1024 || a->ne[0] > INT_MAX || a->ne[1] < 1024 || a->ne[1] > INT_MAX - 3 ||
+        b_stride > INT_MAX || out->ne[0] != a->ne[1]) {
+        return false;
+    }
+    gfx1151_v1_q4_pair<<<(a->ne[1] + 3) / 4, dim3(32, 4), 0, stream>>>(
+        static_cast<const block_q4_0 *>(a->data), static_cast<const block_q8_1 *>(b),
+        static_cast<float *>(out->data), a->ne[1], a->ne[0] / QK4_0, b_stride);
+    return true;
+}
