 namespace {
 
+// Keep the legacy wave32 dot/reduction order, but schedule four rows per group.
+__global__ __launch_bounds__(128) void gfx1151_v1_q4_pair(
+        const block_q4_0 * a, const block_q8_1 * b, float * out,
+        int rows, int blocks, int b_stride) {
+    const int row = int(blockIdx.x) * 4 + threadIdx.y;
+    if (row >= rows) {
+        return;
+    }
+    const int lane = threadIdx.x;
+    constexpr int lanes_per_block = QI4_0 / VDR_Q4_0_Q8_1_MMVQ;
+    const int iqs = VDR_Q4_0_Q8_1_MMVQ * (lane % lanes_per_block);
+    const auto * weights = a + int64_t(row) * blocks;
+    float sum0 = 0.0f;
+    float sum1 = 0.0f;
+    for (int k = lane / lanes_per_block; k < blocks; k += 32 / lanes_per_block) {
+        constexpr int vdr = VDR_Q4_0_Q8_1_MMVQ;
+        int v[vdr], u0[2*vdr], u1[2*vdr];
+        const auto & w = weights[k];
+        const auto & x0 = b[k];
+        const auto & x1 = b[b_stride + k];
+#pragma unroll
+        for (int i = 0; i < vdr; ++i) {
+            v[i] = get_int_b2(w.qs, iqs + i);
+            u0[2*i] = get_int_b4(x0.qs, iqs + i);
+            u0[2*i + 1] = get_int_b4(x0.qs, iqs + i + QI4_0);
+            u1[2*i] = get_int_b4(x1.qs, iqs + i);
+            u1[2*i + 1] = get_int_b4(x1.qs, iqs + i + QI4_0);
+        }
+        sum0 += vec_dot_q4_0_q8_1_impl<vdr>(v, u0, w.d, x0.ds);
+        sum1 += vec_dot_q4_0_q8_1_impl<vdr>(v, u1, w.d, x1.ds);
+    }
+    sum0 = warp_reduce_sum<32>(sum0);
+    sum1 = warp_reduce_sum<32>(sum1);
+    if (lane == 0) {
+        out[row] = sum0;
+        out[int64_t(rows) + row] = sum1;
+    }
+}
