 namespace {
 
+template<int cols>
+__device__ __forceinline__ void gfx1151_v1_q8_row(
+        const block_q8_0 * a, const block_q8_1 * b, float * out,
+        int rows, int blocks, int64_t b_stride) {
+    const int row = int(blockIdx.x) * 4 + threadIdx.y;
+    if (row >= rows) return;
+    const int lane = threadIdx.x;
+    // Each lane applies the scales once to a full block's integer dot product.
+    constexpr int vdr = QI8_0;
+    constexpr int lanes_per_block = QI8_0 / vdr;
+    const int iqs = vdr * (lane % lanes_per_block);
+    const auto * weights = a + int64_t(row) * blocks;
+    float sums[cols] = {};
+    for (int k = lane / lanes_per_block; k < blocks; k += 32 / lanes_per_block) {
+        int v[vdr];
+        const auto & w = weights[k];
+        // Q8_0 rows are only halfword-aligned; preserve that contract.
+        __builtin_memcpy(v, w.qs + sizeof(int) * iqs, sizeof(v));
+#pragma unroll
+        for (int c = 0; c < cols; ++c) {
+            int u[vdr];
+            const auto & x = b[c * b_stride + k];
+#pragma unroll
+            for (int i = 0; i < vdr; ++i) u[i] = get_int_b4(x.qs, iqs + i);
+            sums[c] += vec_dot_q8_0_q8_1_impl<float, vdr>(v, u, w.d, __low2half(x.ds));
+        }
+    }
+#pragma unroll
+    for (int c = 0; c < cols; ++c) {
+        const float sum = warp_reduce_sum<32>(sums[c]);
+        if (lane == 0) out[int64_t(c) * rows + row] = sum;
+    }
+}
+
+template<int cols>
+__global__ __launch_bounds__(128) void gfx1151_v1_q8_wave(
+        const block_q8_0 * a, const block_q8_1 * b, float * out, int rows, int blocks, int64_t stride) {
+    gfx1151_v1_q8_row<cols>(a, b, out, rows, blocks, stride);
+}
+
+struct Q8Group {
+    const block_q8_0 * weights[3];
+    float * outputs[3];
+    int rows[3];
+};
+
+template<int cols>
+__global__ __launch_bounds__(128) void gfx1151_v1_q8_group(
+        Q8Group group, const block_q8_1 * b, int blocks, int64_t stride) {
+    const int i = blockIdx.y;
+    gfx1151_v1_q8_row<cols>(group.weights[i], b, group.outputs[i], group.rows[i], blocks, stride);
+}
+
+template<int cols>
+void launch_q8(const ggml_tensor * a, const void * b, int64_t b_stride, ggml_tensor * out, hipStream_t stream) {
+    gfx1151_v1_q8_wave<cols><<<(a->ne[1] + 3) / 4, dim3(32, 4), 0, stream>>>(
+        static_cast<const block_q8_0 *>(a->data), static_cast<const block_q8_1 *>(b),
+        static_cast<float *>(out->data), a->ne[1], a->ne[0] / QK8_0, b_stride);
+}
