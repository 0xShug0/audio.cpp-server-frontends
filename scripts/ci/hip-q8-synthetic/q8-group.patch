+bool ggml_hip_gfx1151_v1_mmvq(const ggml_tensor * a, const void * b, int64_t b_stride,
+                             ggml_tensor * out, hipStream_t stream, int cc) {
+    if (cc != GGML_CUDA_CC_OFFSET_AMD + 0x1151 || a->type != GGML_TYPE_Q8_0 ||
+        out->op != GGML_OP_MUL_MAT || ggml_get_op_params_i32(out, 1) != GGML_MUL_MAT_LOWERING_DEFAULT ||
+        !ggml_is_matrix(a) || !ggml_is_matrix(out) ||
+        !ggml_is_contiguous(a) || !ggml_is_contiguous(out) ||
+        a->ne[0] > INT_MAX || a->ne[1] > INT_MAX - 3 || out->ne[0] != a->ne[1]) {
+        return false;
+    }
+    switch (out->ne[1]) {
+        case 1: launch_q8<1>(a, b, b_stride, out, stream); return true;
+        case 2: launch_q8<2>(a, b, b_stride, out, stream); return true;
+        case 4: launch_q8<4>(a, b, b_stride, out, stream); return true;
+        case 8: launch_q8<8>(a, b, b_stride, out, stream); return true;
+        default: return false;
+    }
+}
