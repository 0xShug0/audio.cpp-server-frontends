+int ggml_hip_gfx1151_v1_mmvq_group(ggml_backend_cuda_context & ctx, ggml_tensor * const * nodes, int remaining) {
+    if (remaining < 2 || nodes[0]->op != GGML_OP_MUL_MAT ||
+        ggml_cuda_info().devices[ctx.device].cc != GGML_CUDA_CC_OFFSET_AMD + 0x1151) {
+        return 0;
+    }
+    const auto * x = nodes[0]->src[1];
+    const auto buft = ggml_backend_cuda_buffer_type(ctx.device);
+    if (!x || x->type != GGML_TYPE_F32 || !ggml_is_contiguous(x) || !ggml_is_matrix(x) ||
+        (x->ne[1] != 1 && x->ne[1] != 2) || x->ne[0] > INT_MAX - MATRIX_ROW_PADDING ||
+        !x->buffer || ggml_backend_buffer_get_type(x->buffer) != buft) {
+        return 0;
+    }
+    auto overlaps = [](const ggml_tensor * a, const ggml_tensor * b) {
+        const auto pa = reinterpret_cast<std::uintptr_t>(a->data);
+        const auto pb = reinterpret_cast<std::uintptr_t>(b->data);
+        return pa <= pb ? pb - pa < ggml_nbytes(a) : pa - pb < ggml_nbytes(b);
+    };
+    Q8Group group{};
+    int count = 0, rows = 0;
+    for (; count < remaining && count < 3; ++count) {
+        const auto * out = nodes[count];
+        const auto * a = out->src[0];
+        if (out->op != GGML_OP_MUL_MAT || !(out->flags & GGML_TENSOR_FLAG_COMPUTE) ||
+            out->src[1] != x || !a || a->type != GGML_TYPE_Q8_0 || out->type != GGML_TYPE_F32 ||
+            ggml_get_op_params_i32(out, 1) != GGML_MUL_MAT_LOWERING_DEFAULT ||
+            !ggml_is_contiguous(a) || !ggml_is_contiguous(out) || !ggml_is_matrix(a) || !ggml_is_matrix(out) ||
+            a->ne[0] != x->ne[0] || a->ne[1] <= 0 || a->ne[1] > INT_MAX - 3 ||
+            out->ne[0] != a->ne[1] || out->ne[1] != x->ne[1] || !a->buffer || !out->buffer ||
+            ggml_backend_buffer_get_type(a->buffer) != buft || ggml_backend_buffer_get_type(out->buffer) != buft ||
+            ggml_backend_buffer_get_usage(a->buffer) != GGML_BACKEND_BUFFER_USAGE_WEIGHTS ||
+            overlaps(out, x) || overlaps(out, a)) {
+            break;
+        }
+        bool conflict = false;
+        for (int j = 0; j < count; ++j) {
+            conflict |= overlaps(out, nodes[j]) || overlaps(out, nodes[j]->src[0]) || overlaps(a, nodes[j]);
+        }
+        if (conflict) break;
+        group.weights[count] = static_cast<const block_q8_0 *>(a->data);
+        group.outputs[count] = static_cast<float *>(out->data);
+        group.rows[count] = a->ne[1];
+        rows = std::max(rows, group.rows[count]);
+    }
+    if (count < 2) return 0;
+    const int64_t k = x->ne[0], n = x->ne[1], padded = GGML_PAD(k, MATRIX_ROW_PADDING);
+    ggml_cuda_pool_alloc<block_q8_1> q(ctx.pool(), n * padded / QK8_1);
+    auto stream = ctx.stream();
+    quantize_row_q8_1_cuda(static_cast<const float *>(x->data), nullptr, q.get(), GGML_TYPE_Q8_0,
+                          k, k, k*n, k*n, padded, n, 1, 1, stream);
+    const dim3 grid((rows + 3) / 4, count), block(32, 4);
+    if (n == 1) gfx1151_v1_q8_group<1><<<grid, block, 0, stream>>>(group, q.get(), k / QK8_0, padded / QK8_1);
+    else gfx1151_v1_q8_group<2><<<grid, block, 0, stream>>>(group, q.get(), k / QK8_0, padded / QK8_1);
+    return count - 1;
+}
